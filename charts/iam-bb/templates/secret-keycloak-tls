{{- if and .Values.iam.keycloak.tls.enabled .Values.iam.keycloak.tls.autoGenerate -}}
{{- $ca := genCA "keycloak-ca" 365 }}
{{- $serviceName := printf "%s-keycloak-operator-service" .Release.Name }}
{{- $altNames := list (printf "%s.%s.svc.cluster.local" $serviceName .Release.Namespace) (printf "%s.%s" $serviceName .Release.Namespace) $serviceName "127.0.0.1" "localhost" }}
{{- $cert := genSignedCert $serviceName nil $altNames 365 $ca }}
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-tls
  namespace: {{ .Release.Namespace | quote }}
type: kubernetes.io/tls
data:
  tls.crt: {{ $cert.Cert | b64enc }}
  tls.key: {{ $cert.Key | b64enc }}
{{- end }}